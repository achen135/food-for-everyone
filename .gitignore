# editors
.idea/
*.swp


# generated by scripts/copy-maplibre-worker.mjs
/public/maplibre/

# Supabase Studio scratch queries — local scratchpad state, not project source.
/supabase/snippets/

# planning docs + agent brief — authored in the Obsidian vault (source of truth),
# deliberately kept out of the public repo.
#
# `/docs/*` rather than `/docs/` so one subdirectory can be re-included: git
# cannot un-ignore a path whose parent directory is excluded, only one whose
# parent is still walked. Benchmark evidence is not planning — Spec §9 requires
# it committed, because a résumé figure nobody can re-derive is just a claim.
CLAUDE.md
/docs/*
!/docs/benchmarks/

# ...but never the minted k6 session: it holds a live access AND refresh token,
# and the benchmark protocol writes it into that now-tracked directory.
/docs/benchmarks/.session.json
/docs/benchmarks/*.session.json

# ml subsystem (Python). The venv and generated corpus are local artefacts; the
# corpus is regenerated from a seed by `make data`, so committing it would add
# ~300k rows of noise to every diff for no reproducibility gain — the seed and
# the committed stream hash are what make it reproducible.
/ml/.venv/
/ml/out/
/ml/src/*.egg-info/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# M14 drift reports (generated locally by `make drift`; CI uploads them as
# workflow artifacts instead of committing them).
ml/drift-report.txt
ml/drift-report.json
