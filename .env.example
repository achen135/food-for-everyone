# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never import into a client component. Not used yet (reserved for
# admin tasks / seed script in M2–M3).
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Only set this to override the auto-detected origin used for auth
# email / OAuth redirect URLs — e.g. a custom domain. Local dev falls back to
# http://localhost:3000; on Vercel it falls back to VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=
